/*
 * Corne 6x3 - ZMK
 * Adaptado de la configuración anterior de Vial
 */

#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&nice_view_spi { cs-gpios = <&pro_micro 8 GPIO_ACTIVE_HIGH>; };

&led_strip { chain-length = <27>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_acute_n {
            timeout-ms = <300>;
            key-positions = <22 30>;
            bindings = <&n_tilde>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp TAB>;
        };

        combo_arr {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp RA(N2)>;
        };

        combo_BSPC1 {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp LC(BSPC)>;
        };

        combo_BSPC2 {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp BSPC>;
        };

        combo_num {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&tog 1>;
        };

        combo_ene {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp SEMI>;
        };

        combo_ene2 {
            timeout-ms = <50>;
            key-positions = <30 31>;
            bindings = <&kp SEMI>;
        };

        combo_suspende {
            timeout-ms = <50>;
            key-positions = <14 15 16>;
            bindings = <&win_sleep>;
        };

        combo_blqmayus {
            timeout-ms = <50>;
            key-positions = <25 26>;
            bindings = <&kp CLCK>;
        };

        combo_ctrolz {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LC(Z)>;
        };
    };
};

/ {
    behaviors {
        // @ al pulsar normalmente
        // ! al pulsar con Shift

        at_excl: at_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AT_SIGN>, <&kp EXCLAMATION>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        hold_tap {
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        bt0_rgb: behavior_bt0_rgb {
            compatible = "zmk,behavior-macro";
            label = "BT0_RGB";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &rgb_ug RGB_COLOR_HSB(300,100,5)>;
        };

        bt1_rgb: behavior_bt1_rgb {
            compatible = "zmk,behavior-macro";
            label = "BT1_RGB";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &rgb_ug RGB_COLOR_HSB(180,100,5)>;
        };

        bt2_rgb: behavior_bt2_rgb {
            compatible = "zmk,behavior-macro";
            label = "BT2_RGB";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &rgb_ug RGB_COLOR_HSB(0,100,5)>;
        };

        bt3_rgb: behavior_bt3_rgb {
            compatible = "zmk,behavior-macro";
            label = "BT3_RGB";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &rgb_ug RGB_COLOR_HSB(120,100,5)>;
        };

        bt4_rgb: behavior_bt4_rgb {
            compatible = "zmk,behavior-macro";
            label = "BT4_RGB";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &rgb_ug RGB_COLOR_HSB(45,100,5)>;
        };

        win_sleep: win_sleep {
            wait-ms = <500>;
            tap-ms = <5>;
            compatible = "zmk,behavior-macro";
            label = "WIN_SLEEP_KEY";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp G &kp S>;
        };

        n_tilde: n_tilde {
            compatible = "zmk,behavior-macro";
            label = "ñ Macro";
            #binding-cells = <0>;
            bindings = <&kp SEMI>;
        };
    };
};

/ {
    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        // ===================================
        // CAPA 0 - PRINCIPAL
        // ===================================
        //
        // IZQUIERDA       DERECHA
        // TAB Q W E R T   Y U I O P BSPC
        // SFT A S D F G   H J K L ; '
        // CTL Z X C V B   N M , . / @!
        //
        // Pulgares izquierda:
        // CMD / ALT-LAYER3 / ENTER-CTRL
        //
        // Pulgares derecha:
        // SPACE-LAYER1 / MO(1) / ESC-ALT

        default_layer {
            bindings = <
&kp TAB           &kp Q        &kp W  &kp E     &kp R           &kp T       &kp Y        &kp U  &kp I         &kp O    &kp P      &kp BSPC
&kp LEFT_SHIFT    &kp A        &kp S  &kp D     &kp F           &kp G       &kp H        &kp J  &kp K         &kp L    &kp SEMI   &kp SQT
&kp LEFT_CONTROL  &mt LSHFT Z  &kp X  &kp C     &kp V           &kp B       &kp N        &kp M  &kp COMMA     &kp DOT  &kp SLASH  &kp RET
                                      &kp LGUI  &lt 3 LEFT_ALT  &at_excl    &lt 1 SPACE  &mo 1  &mt RALT ESC
            >;
        };

        // ===================================
        // CAPA 1 - VIAL ANTERIOR
        // ===================================
        //
        // IZQUIERDA           DERECHA
        // TAB 1 2 3 4 5       6 7 8 9 0 DEL
        // SFT - - - - -       LEFT DOWN UP RIGHT ( )
        // CTL - - - - -       - - - - - @!
        //
        // Se conservan los accesos de pulgar.
        // Las teclas transparentes mantienen
        // la función de la capa 0.

        lower_layer {
            bindings = <
&kp TAB           &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6    &kp N7    &kp N8  &kp N9     &kp N0      &kp DEL
&kp LEFT_SHIFT    &none   &none   &none   &none   &none     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp LS(N9)  &kp LS(N0)
&kp LEFT_CONTROL  &none   &none   &none   &none   &none     &none     &none     &none   &none      &none       &trans
                                  &trans  &trans  &trans    &trans    &mo 1     &trans
            >;
        };

        // ===================================
        // CAPA 2 - ORIGINAL DEL CORNE
        // ===================================

        raise_layer {
            bindings = <
&none  &none  &none  &none     &none       &kp LS(GRAVE)    &kp RA(LBKT)  &kp RA(RBKT)   &kp RA(SQT)  &kp RA(BSLH)  &kp PSCRN  &none
&none  &none  &none  &none     &none       &kp GRAVE        &kp PLUS      &kp LS(MINUS)  &kp RA(N1)   &kp UP        &kp SEMI   &none
&none  &none  &none  &kp BSLH  &kp RA(N3)  &kp RA(N4)       &kp EQUAL     &kp EXCL       &kp LEFT     &kp DOWN      &kp RIGHT  &none
                     &trans    &trans      &trans           &trans        &trans         &trans
            >;
        };

        // ===================================
        // CAPA 3 - BLUETOOTH Y RGB
        // ===================================

        rgb_layer {
            bindings = <
&none  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(180,100,5)    &rgb_ug RGB_COLOR_HSB(180,100,2)  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_COLOR_HSB(300,100,5)    &rgb_ug RGB_COLOR_HSB(300,100,2)  &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &bt0_rgb         &bt1_rgb         &bt2_rgb         &bt3_rgb         &bt4_rgb                            &kp SEMI                          &kp F1  &kp F2  &kp F3  &kp F13  &none
                                         &bt BT_CLR       &trans           &rgb_ug RGB_TOG                     &trans                            &trans  &trans
            >;
        };
    };
};
